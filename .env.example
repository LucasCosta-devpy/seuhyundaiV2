# Senha de acesso ao painel /admin
ADMIN_PASSWORD=

# Segredo usado pra assinar o token de login (qualquer string aleatória longa)
AUTH_SECRET=

# Essas variáveis já vêm configuradas automaticamente no Vercel:
# POSTGRES_URL / POSTGRES_URL_NON_POOLING  (integração Supabase)
# BLOB_READ_WRITE_TOKEN                     (Vercel Blob Store)
