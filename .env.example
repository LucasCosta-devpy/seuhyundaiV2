# Senha de acesso ao painel /admin
ADMIN_PASSWORD=

# Segredo usado pra assinar o token de login (qualquer string aleatória longa)
AUTH_SECRET=

# Essas variáveis já vêm configuradas automaticamente no Vercel
# quando o Supabase é conectado pelo Vercel Marketplace/Integrations:
# POSTGRES_URL
# POSTGRES_URL_NON_POOLING
# SUPABASE_URL (ou NEXT_PUBLIC_SUPABASE_URL)
# SUPABASE_SERVICE_ROLE_KEY (ou SUPABASE_SECRET_KEY)
